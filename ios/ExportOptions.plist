<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<!-- Manual: the API key has no access to cloud-managed distribution certificates. Signs with the local
	     "Apple Distribution" certificate and the "BNXT App Store" profile (ios/SETUP.md, "Releasing"). -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>teamID</key>
	<string>92HC396B37</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.pjproductions.bnxt</key>
		<string>BNXT App Store</string>
	</dict>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
