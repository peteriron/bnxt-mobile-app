#!/bin/bash
# Pushing config/v1/config.json to main publishes it to every installed app (REQUIREMENTS §7.24).
# REQUIREMENTS §3.9 requires the version policy to pass validation *before* it's published, so this hook
# runs the config tests whenever the pushed commits touch config/. Enable once per clone:
#   git config core.hooksPath tools/hooks
set -euo pipefail
ZERO=0000000000000000000000000000000000000000
CHANGED=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$ZERO" ]] && continue                      # deleting a branch
  if [[ "$remote_sha" == "$ZERO" ]]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  if git diff --name-only "$range" -- config/ 2>/dev/null | grep -q .; then CHANGED=1; fi
done
[[ $CHANGED == 1 ]] || exit 0

echo "▸ config/ changed: validating the remote config before publishing it…"
ROOT="$(git rev-parse --show-toplevel)"
# Validate what's being pushed, not a dirty working tree.
if ! git -C "$ROOT" diff --quiet -- config/; then
  echo "✗ config/ has uncommitted changes; commit or stash them so the pushed version is what gets tested." >&2
  exit 1
fi
cd "$ROOT/ios"
xcodegen generate >/dev/null
if xcodebuild -project BNXT.xcodeproj -scheme BNXT -destination "platform=iOS Simulator,name=${SIM:-iPhone 18 Pro}" \
     -only-testing:BNXTTests/RemoteConfigFileTests -only-testing:BNXTTests/VersionEvaluatorTests \
     -collect-test-diagnostics never CODE_SIGNING_ALLOWED=NO test >"$ROOT/.tmp/pre-push-config.log" 2>&1; then
  echo "✓ config valid"
else
  grep -E "error:|failed" "$ROOT/.tmp/pre-push-config.log" | head -10 >&2
  echo "✗ config validation failed; push aborted. Full log: .tmp/pre-push-config.log" >&2
  exit 1
fi
